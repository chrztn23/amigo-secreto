# Ruta de datos en el servidor. Usa la ruta absoluta si está fuera del proyecto.
AMIGO_HOST_DATA_DIR=./data
AMIGO_HTTP_PORT=5000

# Contraseña para entrar a /panel.
# En local puedes dejarla vacía si ya tienes instance/admin-password.txt.
ADMIN_PASSWORD=

# Clave privada con la que Flask firma las sesiones del navegador.
# Conserva el mismo valor al reiniciar. En el VPS puedes generarla con openssl rand -hex 32.
SECRET_KEY=
